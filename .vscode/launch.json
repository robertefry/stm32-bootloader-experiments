{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Firmware",
            "preLaunchTask": "build-and-flash",
            "cwd": "${workspaceFolder}",
            "executable": "./.build/code/firmware/firmware.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"  // match your MCU series
            ],
            "device": "STM32F446RE",
            "svdFile": "./STM32F446RE.svd"
        },
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", ".build"],
            "problemMatcher": [],
        },{
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", ".build"],
            "problemMatcher": [ "$gcc" ],
            "dependsOn": "cmake-configure",
            "group": { "kind": "build", "isDefault": true }
        },{
            "label": "build-and-flash",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", ".build", "--target", "flash"],
            "problemMatcher": [],
            "dependsOn": "build",
        }
    ]
}
{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build_debug_firmware_elf",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "command": "make MODE=debug elf",
            "problemMatcher": "$gcc",
        },
        {
            "type": "shell",
            "label": "build_release_firmware_elf",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "command": "make MODE=release elf",
            "problemMatcher": "$gcc",
        },
    ],
}
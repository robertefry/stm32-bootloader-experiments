{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_debug_firmware",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "command": "make",
            "args": [ "BUILD=debug", ]
        },
        {
            "label": "make_release",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}" },
            "command": "make",
            "args": [ "BUILD=release", ]
        },
        {
            "label": "flash_release",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}" },
            "command": "make",
            "args": [ "BUILD=release", "flash", ]
        },
        {
            "label": "clean",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}" },
            "command": "make",
            "args": [ "clean", ]
        },
    ],
}